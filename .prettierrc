{
    "bracketSpacing": true,
    "semi": true,
    "tabWidth": 2,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "none",
    "jsxBracketSameLine": true,
    "endOfLine":"auto",
    "parser":"babel",
    "overrides": [
    {
      "files": "*.scss",
      "options": {
        "parser": "scss",
        "singleQuote": false, 
        "tabWidth": 2
      }
    }
  ]
}